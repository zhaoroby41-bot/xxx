        scope.textContent = `范围：${summary.accounts} 个账号的累计笔记；不代表单一账号，也不等同于月度账号总数据增量。`;
      }
      const destroy = id => { const chart = window.Chart && Chart.getChart ? Chart.getChart(id) : null; if (chart) chart.destroy(); };
      const baseOptions = { responsive: true, maintainAspectRatio: true, plugins: { legend: { labels: { color: '#667085' } } }, scales: { x: { ticks: { color: '#667085', maxRotation: 45 }, grid: { color: '#e7edf3' } }, y: { ticks: { color: '#667085' }, grid: { color: '#e7edf3' } } } };
      if (window.Chart) {
        destroy('chartMonthly');
        new Chart(document.getElementById('chartMonthly'), { type: 'line', data: { labels: monthly.map(row => row.month), datasets: [{ label: '累计阅读', data: monthly.map(row => row.reads), borderColor: '#0071e3', backgroundColor: 'rgba(0,113,227,.10)', tension: .35 }, { label: '互动量', data: monthly.map(row => row.interactions), borderColor: '#34a853', backgroundColor: 'rgba(52,168,83,.08)', tension: .35 }, { label: '发布笔记数', data: monthly.map(row => row.notes), borderColor: '#f5a623', backgroundColor: 'rgba(245,166,35,.08)', tension: .35, yAxisID: 'y2' }] }, options: { ...baseOptions, scales: { ...baseOptions.scales, y2: { position: 'right', ticks: { color: '#667085' }, grid: { drawOnChartArea: false } } } } });
        const fiscalKey = month => { const [year, rawMonth] = month.split('-').map(Number); const fiscalYear = rawMonth >= 10 ? year + 1 : year; const fiscalMonth = ((rawMonth - 10 + 12) % 12) + 1; return `FY${String(fiscalYear).slice(-2)} Q${Math.ceil(fiscalMonth / 3)}`; };
        const quarters = {};
        monthly.forEach(row => { const key = fiscalKey(row.month); quarters[key] ||= { reads: 0, interactions: 0, notes: 0 }; quarters[key].reads += row.reads; quarters[key].interactions += row.interactions; quarters[key].notes += row.notes; });
        const quarterLabels = Object.keys(quarters).slice(-4); const percentChange = key => quarterLabels.map((label, index) => index ? ((quarters[label][key] - quarters[quarterLabels[index - 1]][key]) / Math.max(1, quarters[quarterLabels[index - 1]][key]) * 100).toFixed(0) : 0);
        destroy('chartQoQ'); new Chart(document.getElementById('chartQoQ'), { type: 'bar', data: { labels: quarterLabels, datasets: [{ label: '阅读量环比', data: percentChange('reads'), backgroundColor: 'rgba(0,113,227,.70)' }, { label: '互动量环比', data: percentChange('interactions'), backgroundColor: 'rgba(52,168,83,.70)' }, { label: '发布量环比', data: percentChange('notes'), backgroundColor: 'rgba(245,166,35,.75)' }] }, options: { ...baseOptions, scales: { ...baseOptions.scales, y: { ...baseOptions.scales.y, ticks: { color: '#667085', callback: value => `${value}%` } } } } });
        destroy('chartType'); new Chart(document.getElementById('chartType'), { type: 'doughnut', data: { labels: formats.map(item => item.name), datasets: [{ data: formats.map(item => item.count), backgroundColor: ['#0071e3', '#34a853', '#f5a623', '#af52de'], borderWidth: 0 }] }, options: { responsive: true, plugins: { legend: { labels: { color: '#667085' } } } } });
        destroy('chartScatter'); const cohortColor = { S: '#34a853', A: '#0071e3', B: '#f5a623', C: '#8e8e93' }; new Chart(document.getElementById('chartScatter'), { type: 'scatter', data: { datasets: ['S','A','B','C'].map(cohort => ({ label: `${cohort}档`, data: accounts.filter(item => item.cohort === cohort).map(item => ({ x: item.notes, y: item.avg_reads, accountName: item.name })), backgroundColor: cohortColor[cohort], pointRadius: 6 })) }, options: { ...baseOptions, interaction: { mode: 'nearest', intersect: true }, plugins: { legend: { labels: { color: '#667085' } }, tooltip: { callbacks: { title: context => context[0]?.raw?.accountName || '账号', label: context => `发布笔记：${compact(context.raw.x)} · 篇均阅读：${compact(context.raw.y)}` } } }, scales: { ...baseOptions.scales, x: { ...baseOptions.scales.x, title: { display: true, text: '发布笔记数' } }, y: { ...baseOptions.scales.y, title: { display: true, text: '篇均阅读' } } } } });
        destroy('chartFreq'); const top = accounts.slice().sort((left, right) => right.notes - left.notes).slice(0, 30); new Chart(document.getElementById('chartFreq'), { type: 'bar', data: { labels: top.map(item => item.name.slice(0, 14)), datasets: [{ label: '发布笔记数', data: top.map(item => item.notes), backgroundColor: '#0071e3' }] }, options: { ...baseOptions, indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { callbacks: { title: context => top[context[0]?.dataIndex]?.name || '账号', label: context => `发布笔记：${compact(context.raw)}` } } } } });
        const renderTopNoteLinks = chart => {
          const canvas = chart.canvas;
          const container = canvas.parentElement;
          if (!container) return;
          container.style.position = 'relative';
          let overlay = container.querySelector('.top-note-axis-links');
          if (!overlay) {
            overlay = document.createElement('div');
            overlay.className = 'top-note-axis-links';
            overlay.style.cssText = 'position:absolute;inset:0;pointer-events:none;';
            container.appendChild(overlay);
          }
          overlay.innerHTML = '';
          topNotes.forEach((item, index) => {
            if (!item.url) return;
            const label = document.createElement('div');
            label.style.cssText = `position:absolute;left:${canvas.offsetLeft}px;top:${canvas.offsetTop + chart.scales.y.getPixelForValue(index) - 14}px;width:${Math.max(175, chart.chartArea.left - 12)}px;overflow:hidden;font-size:12px;line-height:15px;pointer-events:auto;`;
            const link = document.createElement('a');
            link.href = item.url;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.textContent = item.title.slice(0, 17);
            link.title = `${item.title} · 发布账号：${item.account || '未匹配账号'}`;
            link.style.cssText = 'display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#0071e3;text-decoration:underline;';
            const account = document.createElement('span');
            account.textContent = `发布账号：${item.account || '未匹配账号'}`;
            account.style.cssText = 'display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#6e6e73;font-size:11px;';
            label.append(link, account);
            overlay.appendChild(label);
          });
        };
        const topNotesBox = document.getElementById('chartTop20')?.closest('.chart-box');
        const topNotesHeading = topNotesBox?.querySelector('h3');
        if (topNotesHeading) topNotesHeading.textContent = `Top ${Math.min(20, topNotes.length)} ${source.month} 爆款笔记阅读数排行`;
        destroy('chartTop20'); const topNotesChart = new Chart(document.getElementById('chartTop20'), { type: 'bar', data: { labels: topNotes.map(item => item.title.slice(0, 16)), datasets: [{ label: `${source.month} 阅读`, data: topNotes.map(item => item.reads), backgroundColor: '#0071e3' }] }, options: { ...baseOptions, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { ...baseOptions.scales, y: { ...baseOptions.scales.y, ticks: { color: 'transparent' } } } } }); setTimeout(() => renderTopNoteLinks(topNotesChart), 0);
        destroy('chartInteraction'); new Chart(document.getElementById('chartInteraction'), { type: 'doughnut', data: { labels: ['点赞', '收藏', '评论', '分享'], datasets: [{ data: [life.likes, life.collects, life.comments, life.shares], backgroundColor: ['#0071e3', '#34a853', '#f5a623', '#af52de'], borderWidth: 0 }] }, options: { responsive: true, plugins: { legend: { labels: { color: '#667085' } } } } });
        destroy('chartFans'); new Chart(document.getElementById('chartFans'), { type: 'bar', data: { labels: monthly.map(item => item.month), datasets: [{ label: '全矩阵笔记涨粉合计', data: monthly.map(item => item.new_fans), backgroundColor: '#34a853' }] }, options: baseOptions });
      }
      const tbody = document.querySelector('.data-table tbody');
      if (tbody) tbody.innerHTML = accounts.map((item, index) => `<tr><td>${index + 1}</td><td>${escapeHtml(item.name)}</td><td>${compact(item.notes)}</td><td>${compact(item.avg_reads)}</td><td>${(item.viral_rate * 100).toFixed(1)}%</td><td><span class="badge badge-${item.cohort.toLowerCase()}">${item.cohort}</span></td></tr>`).join('');
      const blocks = document.querySelectorAll('.attribution-block');
      if (blocks[0]) blocks[0].innerHTML = `<h4>关键增长归因</h4>${insights.map(item => `<p>${escapeHtml(item)}</p>`).join('')}`;
      if (blocks[1]) blocks[1].innerHTML = `<h4>经销商矩阵效能分布</h4><p>按篇均阅读划分：S档 ${accounts.filter(item => item.cohort === 'S').length} 个，A档 ${accounts.filter(item => item.cohort === 'A').length} 个，B档 ${accounts.filter(item => item.cohort === 'B').length} 个，C档 ${accounts.filter(item => item.cohort === 'C').length} 个。</p>`;
      if (blocks[2]) blocks[2].innerHTML = `<h4>发布行为分析</h4><p>${escapeHtml(accounts[0] ? `${accounts[0].name} 的篇均阅读为 ${compact(accounts[0].avg_reads)}，可作为高效选题和内容结构的复盘对象。` : '暂无可用账号表现数据。')}</p>`;
      const categoryLead = categories[0] || { category: '未分类', reads: 0, avg_reads: 0 };
      const narrative = [
        { title: '内容同质化风险', text: `${categoryLead.category} 已累计获得 ${compact(categoryLead.reads)} 阅读。应以高表现分类的标题、封面和场景为参考，避免各账号重复发布相似选题。` },
        { title: '爆款内容复盘', text: topNotes[0] ? `当前累计阅读最高的笔记是「${topNotes[0].title}」，累计阅读 ${compact(topNotes[0].reads)}。建议围绕其选题结构和内容形式进行复盘。` : '暂无可复盘的高表现笔记。' },
        { title: '内容机会', text: `以 ${compact(summary.viral_threshold)} 阅读为爆款阈值，累计已有 ${compact(summary.viral_notes)} 条笔记达标；下一步应将高阅读分类的表达方式复制到低效分类。` },
        { title: '互动与转化信号', text: `累计互动 ${compact(life.interactions)}，其中收藏 ${compact(life.collects)}、评论 ${compact(life.comments)}。收藏和评论应进入选题与线索跟进的优先队列。` },
      ];
      blocks.forEach((node, index) => {
        if (index < 3) return;
        const item = narrative[(index - 3) % narrative.length];
        node.innerHTML = `<h4>${item.title}</h4><p>${escapeHtml(item.text)}</p>`;
      });
      document.querySelectorAll('.formula-box, .insight-block').forEach((node, index) => {
        const item = narrative[index % narrative.length];
        node.innerHTML = `<h4>${item.title}</h4><p>${escapeHtml(item.text)}</p>`;
      });
      const footer = document.querySelector('.container > div[style*="text-align:center"]');
      if (footer) footer.textContent = `报告生成时间：${data.generated_at} · 数据来源：${source.workbook} · ${source.fiscal_period} 数据快照`;
    };
    fetchReport().then(hydrateLegacy).catch(error => {
      console.error("Unable to hydrate source-backed legacy report", error);
      const notice = document.querySelector('.header p:nth-of-type(2)');
      if (notice) notice.textContent = `报告数据加载失败：${error.message}`;
    });
  })();
</script>
<script>
  if (document.documentElement.dataset.embed === "apple" && window.parent !== window) {
    const reportHeight = () => window.parent.postMessage({
      type: "history-report-height",
      height: Math.max(document.body.scrollHeight, document.documentElement.scrollHeight),
    }, window.location.origin);
    new ResizeObserver(reportHeight).observe(document.body);
    window.addEventListener("load", reportHeight);
    setTimeout(reportHeight, 300);
  }
</script>
